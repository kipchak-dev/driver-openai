{
    "name": "kipchak/driver-openai",
    "type": "library",
    "description": "An OpenAI driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "OpenAI",
        "AI",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\OpenAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\OpenAI\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "kipchak/driver-http": "^2.10",
        "openai-php/client": "^0.20"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
