{
    "name": "kipchak/driver-openai",
    "type": "library",
    "description": "An OpenAI driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "OpenAI",
        "AI",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\OpenAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\OpenAI\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/driver-config": "^1",
        "kipchak/core": "^2",
        "openai-php/client": "^0.10",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    }
}
